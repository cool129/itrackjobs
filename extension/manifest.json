{
  "manifest_version": 3,
  "name": "iTrackJobs",
  "version": "0.3.0",
  "description": "Log the job you're viewing to iTrackJobs in one click.",
   "permissions": ["scripting", "storage"],
    "host_permissions": [
    "https://ca-itrackjobs.purplecliff-58dc9ef2.eastus2.azurecontainerapps.io/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",

    "https://www.linkedin.com/jobs/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.monster.com/*",
    "https://*.dice.com/*",
    "https://*.simplyhired.com/*",
    "https://*.careerbuilder.com/*",
    "https://*.jobs2careers.com/*",
    "https://wellfound.com/*",
    "https://*.joinhandshake.com/*",

    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*",
    "https://*.smartrecruiters.com/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.jobvite.com/*",
    "https://*.workable.com/*",
    "https://*.bamboohr.com/*",
    "https://*.taleo.net/*",

    "https://www.usajobs.gov/*",
    "https://*.governmentjobs.com/*",
    "https://www.workintexas.com/*",
    "https://*.calcareers.ca.gov/*",
    "https://findajob.dwp.gov.uk/*",
    "https://www.civilservicejobs.service.gov.uk/*",
    "https://www.jobbank.gc.ca/*",
    "https://emploisfp-psjobs.cfp-psc.gc.ca/*",
    "https://www.apsjobs.gov.au/*",
    "https://www.jobs.govt.nz/*",
    "https://*.publicjobs.ie/*",
    "https://eu-careers.europa.eu/*",
    "https://careers.un.org/*",
    "https://www.careers.gov.sg/*",
    "https://www.ncs.gov.in/*",
    "https://jobsuche.arbeitsagentur.de/*",
    "https://choisirleservicepublic.gouv.fr/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Log this job",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  }
}