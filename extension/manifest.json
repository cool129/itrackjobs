{
  "manifest_version": 3,
  "name": "iTrackJobs",
  "version": "0.1.0",
  "description": "Log the job you're viewing to iTrackJobs in one click.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "action": {
    "default_title": "Log this job",
    "default_popup": "popup.html"
  }
}